{
  "$schema": "vscode://schemas/color-theme",
  "name": "Thrift Syntax Highlighting",
  "type": "light",
  "colors": {},
  "tokenColors": [
    {
      "scope": "storage.modifier.thrift",
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "storage.type.key.thrift",
      "settings": {
        "foreground": "#0000FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "storage.type.value.thrift",
      "settings": {
        "foreground": "#008000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "constant.other.key.thrift",
      "settings": {
        "foreground": "#FF0000",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "constant.other.value.thrift",
      "settings": {
        "foreground": "#800080",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.operator.map.separator.thrift",
      "settings": {
        "foreground": "#FF8C00",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "entity.name.type.namespace.thrift",
      "settings": {
        "foreground": "#9400D3",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": "support.type.container.thrift",
      "settings": {
        "foreground": "#00008B",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "support.type.thrift",
      "settings": {
        "foreground": "#4B0082",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.control.thrift",
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "entity.name.type.thrift",
      "settings": {
        "foreground": "#8B0000",
        "fontStyle": "bold"
      }
    }
  ]
}