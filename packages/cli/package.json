{
    "name": "thrift-support",
    "version": "3.1.0",
    "description": "CLI tool for Apache Thrift IDL: format, lint, parse, symbols",
    "bin": {
        "thrift-support": "./dist/cli.js"
    },
    "files": [
        "dist/cli.js",
        "dist/cli.js.map",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "thrift",
        "formatter",
        "linter",
