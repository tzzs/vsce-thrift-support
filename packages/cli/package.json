    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tzzs/vsce-thrift-support.git"
    },
    "license": "MIT",
    "scripts": {
        "build": "node build.js",
        "prepublishOnly": "pnpm run build"
    }
