{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "outDir": "out",
    "lib": [
      "ES2022"
    ],
    "rootDir": "packages/vscode/src",
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "node16",
    "types": [
      "node",
      "vscode"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "declaration": false,
    "removeComments": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "out",
    "tests",
    "test-files",
    "packages/core",
    "packages/cli"
  ],
  "include": [
    "packages/vscode/src/**/*.ts"
  ]
}
