{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Thrift",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#namespace-definitions"
    },
    {
      "include": "#const-definitions"
    },
    {
      "include": "#typedef-definitions"
    },
    {
      "include": "#struct-definitions"
    },
    {
      "include": "#service-definitions"
    },
    {
      "include": "#interaction-definitions"
    },
    {
      "include": "#enum-definitions"
    },
    {
      "include": "#exception-definitions"
    },
    {
      "include": "#union-definitions"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.thrift",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.thrift",
          "match": "#.*$"
        },
        {
          "name": "comment.block.thrift",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.thrift",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "name": "entity.name.tag.thrift",
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)"
            },
            {
              "name": "string.quoted.double.thrift",
              "match": "\\\"([^\\\"\\\\]|\\\\.)*\\\""
            },
            {
              "name": "string.quoted.single.thrift",
              "match": "'([^'\\\\]|\\\\.)*'"
            },
            {
              "name": "constant.numeric.thrift",
              "match": "\\b[0-9]+\\b"
            },
            {
              "name": "constant.language.boolean.thrift",
              "match": "\\b(true|false)\\b"
            },
            {
              "name": "keyword.other.annotation.thrift",
              "match": "\\b(accessor|json_name|go\\.tag|go\\.name|java\\.name|java\\.annotations|java\\.package|py\\.name|py\\.module|js\\.name|php\\.name|php\\.namespace|rb\\.name|ruby\\.namespace|csharp\\.name|csharp\\.namespace|swift\\.name|swift\\.prefix|rust\\.name|scala\\.name|kotlin\\.name|dart\\.name|lua\\.name|perl\\.name|perl\\.package|haskell\\.name|elixir\\.name|clojure\\.name|erlang\\.name|nim\\.name|zig\\.name|v\\.name|odin\\.name|crystal\\.name|d\\.name|groovy\\.name|julia\\.name|r\\.name|matlab\\.name|fortran\\.name|pascal\\.name|ada\\.name|objc\\.name|cpp\\.name|cpp\\.type|cpp\\.ref_type|cpp\\.include|cpp\\.template|cpp\\.namespace|cpp\\.package|cpp\\.header|cpp\\.virtual|cpp\\.getter|cpp\\.setter|cpp\\.adapter|cpp\\.deprecated|cpp\\.experimental|cpp\\.internal|cpp\\.enum|cpp\\.struct|cpp\\.service|cpp\\.interface|cpp\\.final|cpp\\.abstract|cpp\\.sealed|cpp\\.static|cpp\\.public|cpp\\.private|cpp\\.protected|cpp\\.override|cpp\\.default_value|cpp\\.optional|cpp\\.required|cpp\\.const|cpp\\.typedef|cpp\\.nothrow|cpp\\.noexcept|cpp\\.nodiscard|cpp\\.constexpr|cpp\\.inline)\\b"
            },
            {
              "include": "#nested_parens"
            }
          ]
        }
      ]
    },
    "nested_parens": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#annotations"
            }
          ]
        }
      ]
    },
    "namespace-definitions": {
      "patterns": [
        {
          "name": "meta.namespace.thrift",
          "match": "\\b(namespace)\\s+([a-zA-Z_\\*\\.]+)\\s+([a-zA-Z_\\.][a-zA-Z0-9_\\.]*)\\s*(.*)$",
          "captures": {
            "1": {
              "name": "keyword.other.thrift"
            },
            "2": {
              "name": "keyword.other.namespace.thrift"
            },
            "3": {
              "name": "entity.name.namespace.thrift"
            },
            "4": {
              "patterns": [
                {
                  "include": "#annotations"
                },
                {
                  "include": "#comments"
                }
              ]
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.thrift",
          "match": "\\b(struct|union|exception|enum|service|interaction|typedef|const)\\b"
        },
        {
          "name": "storage.modifier.thrift",
          "match": "\\b(required|optional|oneway|async|reference|readonly|final|native|transient|volatile|stream|sink|performs)\\b"
        },
        {
          "name": "keyword.other.thrift",
          "match": "\\b(include|cpp_include|cpp_type|namespace|throws|extends|interaction)\\b"
        },
        {
          "name": "keyword.other.thrift",
          "match": "\\b(cpp_include|cpp_namespace|php_namespace|java_package|py_module|perl_package|ruby_namespace|csharp_namespace|go_package|swift_prefix)\\b"
        },
        {
          "name": "keyword.other.thrift",
          "match": "\\b(c_glib|cpp|delphi|haxe|go|java|js|lua|netstd|perl|php|py|py\\.twisted|rb|st|xsd|BEGIN|END|__CLASS__|__DIR__|__FILE__|__FUNCTION__|__LINE__|__METHOD__|__NAMESPACE__|abstract|alias|and|args|as|assert|begin|break|case|catch|class|clone|continue|declare|def|default|delete|do|dynamic|else|elsif|ensure|except|exec|finally|for|foreach|function|global|if|implements|import|in|inline|instanceof|interface|is|lambda|module|native|new|next|not|or|package|private|protected|public|raise|redo|rescue|retry|return|self|sizeof|static|super|switch|synchronized|then|this|throw|try|undef|unless|until|use|var|virtual|when|while|with|xor|yield)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "keyword.other.thrift",
          "match": "\\bcpp_type\\b"
        },
        {
          "name": "storage.type.primitive.thrift",
          "match": "\\b(void|bool|byte|i8|i16|i32|i64|double|string|binary|uuid)\\b"
        },
        {
          "name": "storage.type.collection.thrift",
          "match": "\\b(map|list|set|slist|senum|stream|sink)\\b"
        },
        {
          "name": "entity.name.type.thrift",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.type.thrift",
          "match": "\\b[a-zA-Z0-9_]+\\.[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "nested-types": {
      "patterns": [
        {
          "begin": "\\b(map)\\s*<",
          "beginCaptures": {
            "1": {
              "name": "storage.type.collection.thrift"
            }
          },
          "end": ">",
          "patterns": [
            {
              "include": "#nested-types"
            },
            {
              "include": "#types"
            },
            {
              "name": "entity.name.type.thrift",
              "match": "[a-zA-Z0-9_]+\\.[A-Z][a-zA-Z0-9_]*"
            },
            {
              "include": "#annotations"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#punctuation-comma"
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "begin": "\\b(set|list)\\s*<",
          "beginCaptures": {
            "1": {
              "name": "storage.type.collection.thrift"
            }
          },
          "end": ">",
          "patterns": [
            {
              "include": "#nested-types"
            },
            {
              "include": "#types"
            },
            {
              "name": "entity.name.type.thrift",
              "match": "[a-zA-Z0-9_]+\\.[A-Z][a-zA-Z0-9_]*"
            },
            {
              "include": "#annotations"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "begin": "\\b(senum|slist|stream|sink)\\s*<",
          "beginCaptures": {
            "1": {
              "name": "storage.type.collection.thrift"
            }
          },
          "end": ">",
          "patterns": [
            {
              "include": "#nested-types"
            },
            {
              "include": "#types"
            },
            {
              "name": "entity.name.type.thrift",
              "match": "[a-zA-Z0-9_]+\\.[A-Z][a-zA-Z0-9_]*"
            },
            {
              "include": "#annotations"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.thrift",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.hex.thrift",
          "match": "\\b0x[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.float.thrift",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.thrift",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.other.list.thrift",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#constants"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "constant.other.map.thrift",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "name": "meta.map.entry.thrift",
              "patterns": [
                {
                  "name": "constant.other.key.thrift",
                  "patterns": [
                    {
                      "include": "#constants"
                    },
                    {
                      "include": "#strings"
                    }
                  ]
                },
                {
                  "name": "punctuation.separator.key-value.thrift",
                  "match": ":"
                },
                {
                  "name": "constant.other.value.thrift",
                  "patterns": [
                    {
                      "include": "#constants"
                    },
                    {
                      "include": "#strings"
                    },
                    {
                      "begin": "\\{",
                      "end": "\\}",
                      "patterns": [
                        {
                          "include": "#meta.map.entry.thrift"
                        },
                        {
                          "include": "#punctuation-comma"
                        },
                        {
                          "include": "#comments"
                        }
                      ]
                    }
                  ]
                },
                {
                  "include": "#punctuation-comma"
                }
              ]
            },
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.thrift",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.thrift",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.thrift",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.thrift",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.thrift",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.hex.thrift",
          "match": "\\b0x[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.float.thrift",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.thrift",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.thrift",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation-comma": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.thrift",
          "match": ","
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.definition.block.thrift",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.bracket.thrift",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.paren.open.thrift",
          "match": "\\("
        },
        {
          "name": "punctuation.paren.close.thrift",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.colon.thrift",
          "match": ":"
        },
        {
          "name": "punctuation.separator.semicolon.thrift",
          "match": ";"
        },
        {
          "name": "punctuation.definition.generic.thrift",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.assignment.thrift",
          "match": "="
        },
        {
          "name": "keyword.operator.thrift",
          "match": "[\\$]"
        }
      ]
    },
    "struct-definitions": {
      "patterns": [
        {
          "name": "meta.struct.thrift",
          "begin": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(\\{)|$)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.thrift"
            },
            "2": {
              "name": "entity.name.type.class.thrift"
            },
            "3": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#field-definitions"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#punctuation-comma"
            },
            {
              "include": "#annotations"
            }
          ]
        }
      ]
    },
    "service-definitions": {
      "patterns": [
        {
          "name": "meta.service.thrift",
          "begin": "\\b(service)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(?:(extends)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*))?(?:\\s*(\\{)|$)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.thrift"
            },
            "2": {
              "name": "entity.name.type.interface.thrift"
            },
            "3": {
              "name": "keyword.other.thrift"
            },
            "4": {
              "name": "entity.other.inherited-class.thrift"
            },
            "5": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#method-definitions"
            },
            {
              "include": "#annotations"
            }
          ]
        }
      ]
    },
    "interaction-definitions": {
      "patterns": [
        {
          "name": "meta.interaction.thrift",
          "begin": "\\b(interaction)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(?:(extends)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*))?(?:\\s*(\\{)|$)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.thrift"
            },
            "2": {
              "name": "entity.name.type.interface.thrift"
            },
            "3": {
              "name": "keyword.other.thrift"
            },
            "4": {
              "name": "entity.other.inherited-class.thrift"
            },
            "5": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#method-definitions"
            },
            {
              "include": "#annotations"
            }
          ]
        }
      ]
    },
    "enum-definitions": {
      "patterns": [
        {
          "name": "meta.enum.thrift",
          "begin": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(\\{)|$)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.thrift"
            },
            "2": {
              "name": "entity.name.type.enum.thrift"
            },
            "3": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#operators"
            },
            {
              "name": "meta.enum.field.thrift",
              "match": "\\s*([A-Za-z_][a-zA-Z0-9_]*)(?:\\s*(=)\\s*(-?[0-9]+))?\\s*(,)?",
              "captures": {
                "1": {
                  "name": "constant.other.enum.thrift"
                },
                "2": {
                  "name": "keyword.operator.assignment.thrift"
                },
                "3": {
                  "name": "constant.numeric.thrift"
                },
                "4": {
                  "name": "punctuation.separator.comma.thrift"
                }
              }
            },
            {
              "include": "#annotations"
            }
          ]
        }
      ]
    },
    "exception-definitions": {
      "patterns": [
        {
          "name": "meta.exception.thrift",
          "begin": "\\b(exception)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(\\{)|$)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.thrift"
            },
            "2": {
              "name": "entity.name.type.exception.thrift"
            },
            "3": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#field-definitions"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#punctuation-comma"
            },
            {
              "include": "#annotations"
            }
          ]
        }
      ]
    },
    "union-definitions": {
      "patterns": [
        {
          "name": "meta.union.thrift",
          "begin": "\\b(union)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(\\{)|$)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.thrift"
            },
            "2": {
              "name": "entity.name.type.class.thrift"
            },
            "3": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.thrift"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#field-definitions"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#punctuation-comma"
            },
            {
              "include": "#annotations"
            }
          ]
        }
      ]
    },
    "const-definitions": {
      "patterns": [
        {
          "name": "meta.const.thrift",
          "match": "\\b(const)\\s+([a-zA-Z_][a-zA-Z0-9_<>, .]*)\\s+([A-Z_][A-Z0-9_]*)\\s*(=)\\s*(.*)$",
          "captures": {
            "1": {
              "name": "storage.type.thrift"
            },
            "2": {
              "patterns": [
                {
                  "include": "#nested-types"
                },
                {
                  "include": "#types"
                }
              ]
            },
            "3": {
              "name": "variable.other.constant.thrift"
            },
            "4": {
              "name": "keyword.operator.assignment.thrift"
            },
            "5": {
              "patterns": [
                {
                  "include": "#constants"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#comments"
                }
              ]
            }
          }
        }
      ]
    },
    "typedef-definitions": {
      "patterns": [
        {
          "name": "meta.typedef.thrift",
          "begin": "\\b(typedef)\\s+",
          "beginCaptures": {
            "1": {
              "name": "storage.type.thrift"
            }
          },
          "end": "\\s+([A-Z][a-zA-Z0-9_]*)\\s*(.*)$",
          "endCaptures": {
            "1": {
              "name": "entity.name.type.thrift"
            },
            "2": {
              "name": "meta.annotation.thrift"
            }
          },
          "patterns": [
            {
              "include": "#nested-types"
            },
            {
              "include": "#types"
            },
            {
              "name": "punctuation.separator.thrift",
              "match": ","
            },
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "field-definitions": {
      "patterns": [
        {
          "name": "meta.field.thrift",
          "begin": "\\s*([0-9]+)\\s*:\\s*(required|optional)?\\s*",
          "beginCaptures": {
            "1": {
              "name": "constant.numeric.thrift"
            },
            "2": {
              "name": "storage.modifier.thrift"
            }
          },
          "end": "\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "endCaptures": {
            "1": {
              "name": "variable.other.member.thrift"
            }
          },
          "patterns": [
            {
              "include": "#nested-types"
            },
            {
              "include": "#types"
            },
            {
              "include": "#annotations"
            },
            {
              "include": "#comments"
            }
          ]
        }
